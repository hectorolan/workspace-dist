# Copy to .env for docker compose runs. .env is gitignored — NEVER commit real values.
# On the Azure VM the real file lives at ~/agent/workspace/.env (chmod 600, never in git).
# `# env-doctor:` / `# env-doctor-off:` lines are capability markers read by the
# control-plane env check (grammar: SYSTEM.md "Per-service env health").

# --- required -------------------------------------------------------------------
# Claude Code auth — set ONE of these. Generate the long-lived OAuth token on any
# machine that's already logged in:  claude setup-token
# env-doctor: required — Agent sessions (Claude auth)
CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# GitHub PAT (classic, `repo` scope, or fine-grained with contents+pull-requests r/w
# on your workspace repo and project repos). Used to clone/pull/push and drive PRs.
# env-doctor: required — GitHub sync, PRs & deploys
GITHUB_TOKEN=

# --- identity (REQUIRED — no code defaults since 2026-07-20; fail fast) -----------
# OWNER_EMAIL  — the human owner: reports/replies are delivered here, and only mail
#                FROM this address is trusted as an agent request.
# AGENT_EMAIL  — the agent's identity: outgoing mail is sent From it, and only mail
#                addressed To it is captured as a request. A Gmail +alias of the
#                owner account today; point it at a dedicated account later and the
#                whole channel moves with no code change.
# MAIL_ACCOUNT — optional derivation: the real SMTP/IMAP login account (defaults to
#                OWNER_EMAIL; set it only if the agent gets its own account — then
#                GMAIL_APP_PASSWORD below is THAT account's app password).
# env-doctor: required — Owner & agent mail identity
OWNER_EMAIL=you@example.com
AGENT_EMAIL=you+agent@example.com
#MAIL_ACCOUNT=
# Git author for all automation commits (container) — REQUIRED there:
# env-doctor: required — Container git author & workspace clone source
GIT_USER_NAME=your-github-username
GIT_USER_EMAIL=you@example.com
# The workspace repo the container clones — REQUIRED there (env-only by necessity:
# it's needed BEFORE the repo, and thus configs/environments.json, exists):
WORKSPACE_REPO_URL=https://github.com/your-github-username/workspace.git

# --- required for report email delivery ------------------------------------------
# Gmail app password. Use the ROTATED value only — the old one was exposed and must
# not be reused on a new environment (see SETUP.md email row).
# env-doctor: required — Report email delivery
GMAIL_APP_PASSWORD=

# --- environment identity (configs/environments.json) ------------------------------
# Which environment this is. The ws scheduler only arms jobs when this matches
# scheduleOwner in configs/environments.json (one live job host, enforced).
# env-doctor: required — Station identity & schedule ownership
WS_ENV=azure-vm

# --- optional (defaults shown) ----------------------------------------------------
# env-doctor: optional — Schedule timezone & agent tuning
# env-doctor-off: defaults apply (TZ America/Los_Angeles, provider claude, dispatcher model haiku)
TZ=America/Los_Angeles
#AGENT_PROVIDER=claude
#AGENT_MODEL=haiku                    # model for the outer dispatcher session (cli/util/agent.js; the subagent's own model: does the real work)
#AGENT_ALLOWED_TOOLS=Read,Write,Glob,Grep,WebSearch,WebFetch
#INBOX_ALLOWED_TOOLS=                 # tool allowlist for inbox orchestrator sessions (cli/util/runinbox.js)
#TITLE_MODEL=haiku                    # model for the one-time conversation-title call (ws run-inbox)
#JOB_TAG=                             # suffix appended to job email subjects (e.g. " [container test]")
#WS_DATA_DIR=                         # per-machine data dir (default: the dir holding LOG_DB_PATH, i.e. ~/sources/data)
#WORKSPACE_DIR=                       # the workspace clone scripts treat as home (default ~/sources/workspace)
#WS_JOBS_CONFIG=                      # override path to configs/jobs/jobs.json (scheduler + server schedule-timezone source)
#WS_ENVS_CONFIG=                      # override path to configs/environments.json (scheduler ownership)
# (identity vars moved to the REQUIRED section above, 2026-07-20)

# --- central logging API (workspace/server/, defaults shown) ----------------------
#LOG_API_PORT=8790
#LOG_API_HOST=127.0.0.1
#LOG_DB_PATH=/home/node/sources/data/logs.db
#LOG_API_URL=http://127.0.0.1:8790    # the ws client (node cli/ws.js) talks to this.
# Off-host environments keep this on loopback too and tunnel it over SSH (never plain HTTP
# across the internet — see server/README.md "PC (off-host) access").
# REQUIRED whenever LOG_API_HOST is not loopback (the VM: compose binds 0.0.0.0 and
# publishes 8790 for the hub container + the VM-local tunnel endpoint; no NSG rule
# admits 8790 from the internet — off-host access is the SSH tunnel only) — the server
# REFUSES TO START without it there, because an unauthenticated published API would
# hand out agent sessions (see server/README.md).
# env-doctor: required — Central log API auth
LOG_API_KEY=
#BACKUP_REPO_URL=                     # override only — the value lives in configs/environments.json (backupRepoUrl)

# Google OAuth sign-in credentials belong to hub (read only by hub/src/config.js,
# declared in hub/.env.example) — they are required where that service exists, not here.
