# hub environment variables — names only, real values live in .env (gitignored).
# Copy this file to .env and fill in the values.
# `# env-doctor:` / `# env-doctor-off:` lines are capability markers read by the
# workspace control-plane env check (grammar: workspace SYSTEM.md "Per-service env
# health") — the repo owning a var owns its label.

# Google OAuth web client (project ho-nexus, Cloud Console). Real values are in the
# workspace repo's .env — copy them here, never commit them.
# env-doctor: required — Google sign-in
# env-doctor-off: nobody can sign in — the Google OAuth round-trip cannot start
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# REQUIRED — the ONE Google account allowed in (the server-side allowlist, exact
# case-sensitive match). The auth gate FAILS CLOSED: unset/empty means every login is
# denied and the server logs one loud boot line naming this var (CEO-is-config,
# hn-ceo-is-config-2026-08-15).
# env-doctor: required — Owner allowlist
# env-doctor-off: every login is denied — the auth gate fails closed until this is set
ALLOWED_EMAIL=

# Public base URL of the app. The OAuth redirect URI is derived as BASE_URL + /auth/callback,
# and only these two are registered with Google:
#   local dev:   http://localhost:8080  ->  http://localhost:8080/auth/callback
#   production:  https://ho-nexus.westus2.cloudapp.azure.com
# env-doctor: required — Public address
# env-doctor-off: the redirect URI falls back to http://localhost:8080 — production sign-in breaks
BASE_URL=http://localhost:8080

# Port the app listens on. Keep 8080 locally (matches the registered redirect URI).
# env-doctor: optional — Listen port
# env-doctor-off: default 8080 applies (matches the registered redirect URI)
PORT=8080

# Workspace log API (Digests, Conversations, Plans sections). Server-side only — the key
# is sent as X-Api-Key from the Node process and must never reach the browser. Leave
# LOG_API_URL empty to disable those sections (they render a "not configured" page).
#   local dev (PC): both are already user env vars on this machine (see workspace
#     server/README.md "PC (off-host) access") — you can leave them out of .env.
#   production (Azure VM): the app container reaches the log API published on the VM
#     host at port 8790; set LOG_API_URL to the host address reachable from the
#     container (e.g. http://host.docker.internal:8790 with an
#     `extra_hosts: ["host.docker.internal:host-gateway"]` entry in the prod compose)
#     and LOG_API_KEY to the same value as in ~/agent/workspace/.env. Real values
#     never in this file.
# env-doctor: optional — Digests, Conversations & Plans
# env-doctor-off: those sections show "not configured"; the rest of the app is unaffected
LOG_API_URL=
LOG_API_KEY=

# Secret used to sign the session cookie. Generate a long random string for real use.
# env-doctor: required — Signed session cookies
# env-doctor-off: a random per-process secret is generated — every restart invalidates all sessions
SESSION_SECRET=

# DEV/TEST ONLY — auth bypass. When AUTH_BYPASS is the literal string "true", the app
# skips the Google login and pretends AUTH_BYPASS_EMAIL was authenticated by Google.
# The server-side allowlist (ALLOWED_EMAIL) STILL applies.
# MUST remain unset/false in any real deployment; the production compose config must
# never set it. Default: off.
# env-doctor: optional — Login bypass
# env-doctor-off: off is correct in production — dev/test only; the real Google login runs
AUTH_BYPASS=false
AUTH_BYPASS_EMAIL=you@example.com

# Custom pages root (the pages framework — design hub-home-custom-pages-design Part 2).
# Every direct subfolder of this directory becomes ONE top-level tab: the folder's index
# file decides the tier (index.html > index.json > index.md), page.json optionally sets
# title/order/icon, and the scan is live — drop a folder in, reload, the tab is there.
# Relative paths resolve against the repo root; absolute paths pass through.
# UNSET = the feature is off: no tab appears at all.
# env-doctor: optional — Custom pages
# env-doctor-off: custom pages are off — no user tabs; the rest of the app is unaffected
HUB_PAGES_DIR=

# Workspace .claude directory (the Claude tab's Core / Agents / Skills pages) — the root that
# contains agents/, skills/, CLAUDE.md, SETUP.md.
# Local default (resolved relative to the repo root): ../workspace/.claude
# In Docker the compose file mounts the host .claude dir at /data/claude and sets this.
# In production the prod compose reuses the workspace_sources volume mount and sets
# WORKSPACE_CLAUDE_DIR=/data/workspace-sources/workspace/.claude (see docker-compose.yml).
# env-doctor: optional — Claude tab (Core, Agents & Skills)
# env-doctor-off: default ../workspace/.claude applies (resolved relative to the repo root)
WORKSPACE_CLAUDE_DIR=../workspace/.claude
