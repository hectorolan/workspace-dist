{
  "name": "workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace automation — single Node.js runtime (design record: ws plan get 2026-07-19-nodejs-runtime-restructure)",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "cli",
    "server"
  ],
  "scripts": {
    "test": "node --test \"cli/test/*.test.js\"",
    "test:all": "npm test && npm test --workspace server",
    "typecheck": "tsc",
    "licenses": "license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;BlueOak-1.0.0;CC-BY-3.0\" --excludePrivatePackages"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^7.0.2"
  }
}
